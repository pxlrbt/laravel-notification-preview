{
    "name": "pxlrbt/laravel-notification-preview",
    "description": "Browse, preview and test-send every notification and mailable in your Laravel app – mail as HTML and text, other channels as their payload.",
    "keywords": ["laravel", "mail", "mailable", "email", "notification", "preview", "viewer", "markdown-mail", "developer-tools"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dennis Koch",
            "email": "info@pxlrbt.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.0",
        "illuminate/contracts": "^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "pxlrbt\\LaravelNotificationPreview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "pxlrbt\\LaravelNotificationPreview\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "XDEBUG_MODE=off vendor/bin/pint",
        "analyse": "XDEBUG_MODE=off vendor/bin/phpstan --memory-limit=512M",
        "test": "XDEBUG_MODE=off vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "pxlrbt\\LaravelNotificationPreview\\NotificationPreviewServiceProvider"
            ],
            "aliases": {
                "NotificationPreview": "pxlrbt\\LaravelNotificationPreview\\Facades\\NotificationPreview"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
